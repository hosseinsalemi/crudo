{
  "name": "crudo",
  "private": true,
  "description": "Crudo — a production-grade CRUD framework for TypeScript (monorepo root).",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "depcruise": "depcruise packages --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "prettify": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run build && pnpm run depcruise && pnpm run test"
  },
  "devDependencies": {
    "@swc/core": "^1.7.26",
    "dependency-cruiser": "^16.10.0",
    "prettier": "^3.9.6",
    "typescript": "^5.5.4",
    "unplugin-swc": "^1.5.1",
    "vitest": "^3.0.5"
  }
}
