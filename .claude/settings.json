{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": ["Bash(npm publish:*)", "Bash(pnpm publish:*)"],
    "allow": [
      "Bash(git status:*)",
      "Bash(git rev-parse:*)",
      "Bash(git describe:*)",
      "Bash(git branch --show-current)",
      "Bash(git remote -v)",
      "Bash(git tag --points-at:*)",
      "Bash(gh repo view:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh label list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(pnpm check:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm depcruise:*)",
      "Bash(pnpm format:check:*)",
      "Bash(pnpm docs:links:*)",
      "Bash(pnpm docs:build:*)",
      "Bash(pnpm vitest:*)"
    ]
  }
}
